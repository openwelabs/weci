# WeCi environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# API key for the model service. Leave empty to set it in the browser instead.
WECI_API_KEY=

# Default model endpoint (OpenAI-compatible).
WECI_DEFAULT_API_BASE=https://api.openai.com/v1

# Default model name.
WECI_DEFAULT_MODEL=gpt-4o-mini

# Default temperature (0.0 - 2.0).
WECI_DEFAULT_TEMPERATURE=0.7

# Default max tokens (leave empty for no limit).
WECI_DEFAULT_MAX_TOKENS=

# Listen address. Use 0.0.0.0 to expose on the LAN.
WECI_HOST=127.0.0.1

# Listen port.
WECI_PORT=8000

# CORS origins, comma-separated. * allows all.
WECI_CORS_ORIGINS=*

# Web search provider: duckduckgo (default, no key) or tavily.
WECI_WEB_SEARCH_PROVIDER=duckduckgo

# Required only when WECI_WEB_SEARCH_PROVIDER=tavily.
TAVILY_API_KEY=
